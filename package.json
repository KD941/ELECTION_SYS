{
  "name": "elected-election-assistant",
  "version": "1.0.0",
  "description": "ElectED — Interactive civic education platform with Gemini AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
